{
  "name": "emg-waveform-overlay",
  "productName": "EMG Overlay",
  "version": "1.1.0",
  "description": "SpikerBox 근전도로 키를 누르고, 게임 위에 파형을 띄우는 오버레이",
  "main": "src/main/main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "test": "node test/all.test.js",
    "test:keys": "electron test/keys.integration.js",
    "build:win": "electron-builder --win portable --x64 -c.win.signAndEditExecutable=false"
  },
  "build": {
    "appId": "school.festival.emgoverlay",
    "productName": "EMG Overlay",
    "npmRebuild": false,
    "files": [
      "src/**/*",
      "assets/**/*",
      "package.json"
    ],
    "asarUnpack": [
      "node_modules/node-hid/**",
      "node_modules/koffi/**"
    ],
    "win": {
      "target": [
        "portable"
      ],
      "signAndEditExecutable": false
    },
    "portable": {
      "artifactName": "emg-waveform-overlay.exe"
    }
  },
  "devDependencies": {
    "electron": "^33.4.11",
    "electron-builder": "^25.1.8",
    "pretendard": "^1.3.9"
  },
  "dependencies": {
    "koffi": "^3.3.3",
    "node-hid": "^3.4.0"
  }
}
